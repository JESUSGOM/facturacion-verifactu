  "nif": "B12345678",
  "razonSocial": "Empresa de Prueba SL",
  "nombreComercial": "Empresa Prueba",
  "direccion": "Calle de Prueba 1",
  "codigoPostal": "38001",
  "municipio": "Santa Cruz de Tenerife",
  "provincia": "Santa Cruz de Tenerife",
  "codigoPais": "ES",
  "telefono": "922000000",
  "email": "prueba@example.com",
  "tipoImpuesto": "IGIC"
}

