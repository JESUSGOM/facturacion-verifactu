      "cantidad": 1
    }
  ]
}

### Comprobar FAC antes de emitir la segunda factura
GET http://localhost:8081/api/empresas/1/series-facturacion/1

### Emitir factura 2
POST http://localhost:8081/api/empresas/1/facturas/2/emitir

### Comprobar FAC después de emitir factura 2
GET http://localhost:8081/api/empresas/1/series-facturacion/1

### Obtener factura 2
GET http://localhost:8081/api/empresas/1/facturas/2

